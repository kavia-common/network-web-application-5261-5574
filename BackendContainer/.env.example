# Flask/MongoDB Backend Configuration

# Port the Flask app will listen on (default 3001)
APP_PORT=3001

# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# MongoDB connection URI (adjust as needed)
# For local MongoDB, default is mongodb://localhost:27017
MONGO_URI=mongodb://localhost:27017

# Database and collection names
MONGO_DB_NAME=network_devices
MONGO_COLLECTION=devices
