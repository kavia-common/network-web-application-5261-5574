# Server
APP_PORT=3001
LOG_LEVEL=INFO

# Database
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=network_devices
MONGO_COLLECTION=devices

# CORS
# Comma-separated list of allowed origins. For development you may set "*" (not recommended for production).
# Default (if unset) will be the frontend deployment origin: https://network-web-application-1.kavia.app
ALLOWED_ORIGINS=https://network-web-application-1.kavia.app
# Whether to support cookies/authorization headers with CORS requests
CORS_ALLOW_CREDENTIALS=true
# Allowed HTTP methods for CORS
CORS_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
# Allowed request headers for CORS
CORS_ALLOW_HEADERS=Content-Type,Authorization,X-Requested-With
